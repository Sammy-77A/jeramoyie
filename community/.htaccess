# Enable URL rewriting for community portal
RewriteEngine On
RewriteBase /community/

# Don't rewrite existing files/directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Block direct .php access — redirect to clean URL
# (Disabled temporarily due to 404 issues)
# RewriteCond %{THE_REQUEST} \s/community/(.+?)\.php[\s?] [NC]
# RewriteRule ^ /community/%1 [R=301,L]

# Internally add .php extension
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]
