; Names only - copy to .env and fill in on the server. Never commit real values.
; Comments must be on their own line starting with ";" (inline comments become part of the value).
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
; "sandbox" or "live"
MPESA_ENV=sandbox
MPESA_CALLBACK_URL=https://your-domain/callback_url.php
; long random string, appended to callback URLs as ?k=...
MPESA_CALLBACK_SECRET=
; membership registration fee in KSh (defaults to 200 if unset)
MPESA_REG_FEE=
; lets cron call the web cron scripts as ?key=... (command line needs none)
CRON_SECRET=
MAIL_USERNAME=
MAIL_PASSWORD=
B2C_CONSUMER_KEY=
B2C_CONSUMER_SECRET=
B2C_SHORTCODE=
B2C_INITIATOR=
B2C_SECURITY_CREDENTIAL=
B2C_RESULT_URL=
B2C_TIMEOUT_URL=
